# BeeLLaMA v0.4.7 Escha SM120 release route profile.
# The bundle launcher sets ESCHA_BRIDGE_ROOT to its own bridge directory and
# sources this file with `set -a`, so the shipped defaults ARE the qualified
# routes. Model-specific switches are applied by the launcher, not by hand.
ESCHA_BRIDGE_ROOT=${ESCHA_BRIDGE_ROOT:-/home/sean/kernel-lab5090/preview-bridge-sm120}
ESCHA_OFFICIAL_BRIDGE_LIBRARY="$ESCHA_BRIDGE_ROOT/libescha_official_bridge_cuda_sm120.so"
ESCHA_OFFICIAL_CODE_GEMM_CUBIN="$ESCHA_BRIDGE_ROOT/code-gemm-sm120.cubin"
ESCHA_OFFICIAL_F32_DECODE_CUBIN="$ESCHA_BRIDGE_ROOT/f32_input.sm120.cubin"
ESCHA_OFFICIAL_F32_DECODE_INPUT_ABI=f32
ESCHA_OFFICIAL_RAW_BRIDGE=1
ESCHA_OFFICIAL_RAW_SWIGLU_FUSION=1
ESCHA_OFFICIAL_RAW_DECODE_BRIDGE=1
ESCHA_OFFICIAL_RAW_DECODE_F32_INPUT=1
ESCHA_OFFICIAL_RAW_DECODE_SWIGLU_FUSION=1
ESCHA_OFFICIAL_RAW_DECODE_K3_SPLIT_DIV2=0
ESCHA_OFFICIAL_BRIDGE_ACCUMULATION=mixed
# Escha-only K=1 prefill bridge. The launcher enables it for e3/w2 and leaves
# it off for the stock GGUF target, whose logits fail that bridge's guard.
ESCHA_GDN_CHUNK_BRIDGE=0
ESCHA_E3_EMBED_GPU=1
ESCHA_OFFICIAL_RAW_DECODE_DOWN_ADD_RMS_FUSION=1
ESCHA_OFFICIAL_RAW_DECODE_K3_DOWN_SPLITS=16
ESCHA_OFFICIAL_RAW_DECODE_QKV_Z_BETA_ALPHA_OVERLAP=1
ESCHA_DIRECT_RECURRENT_STATE_R258=1
ESCHA_DIRECT_RECURRENT_CONV_R260=1
ESCHA_FUSE_GDN_DECODE_PREP_R262=1
ESCHA_FUSE_GDN_NORM_GATE_R264=1
ESCHA_OFFICIAL_RAW_DECODE_GATE_UP_OVERLAP=1
ESCHA_OFFICIAL_RAW_DECODE_OVERLAP_GATE_SPLITS=4
ESCHA_OFFICIAL_RAW_DECODE_OVERLAP_UP_FIRST=0
ESCHA_OFFICIAL_RAW_DECODE_OVERLAP_UP_AUX=0
ESCHA_OFFICIAL_RAW_DECODE_OVERLAP_AUX_HIGH_PRIORITY=0
ESCHA_OFFICIAL_RAW_DECODE_QKV_Z_OVERLAP=1
ESCHA_OFFICIAL_RAW_DECODE_ATTN_QKV_OVERLAP=1
# The W2 original-INT8 head is single-row, so the launcher selects it only
# for ordinary decode and clears it for five-row DFlash verification.
ESCHA_W2_I8_HEAD=0
