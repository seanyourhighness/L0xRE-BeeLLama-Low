+// Mark the Escha decode path as owning compact Q/K heads.  The CUDA fused
+// kernel expands the grouped heads while applying the per-head L2 norm, so the
+// graph does not need to materialize a repeated Q/K tensor.
+GGML_API void ggml_gated_delta_net_set_grouped_qk_norm(struct ggml_tensor * tensor, float eps) {
