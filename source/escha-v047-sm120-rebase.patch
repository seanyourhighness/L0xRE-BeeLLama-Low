+struct llm_escha_moe {
+    struct ggml_tensor * lut    = nullptr;
+    struct ggml_tensor * dep_k2 = nullptr;
+    struct ggml_tensor * dep_k3 = nullptr;
+
+    llm_escha_exps gate;
+    llm_escha_exps up;
+    llm_escha_exps down;
+
+    bool active() const { return down.active(); }
+};
