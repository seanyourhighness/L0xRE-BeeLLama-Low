+// ggml_compute_forward_escha_moe
+
+// normalized Sylvester-Hadamard over each block of 128, in place. the Sylvester
+// construction H_2n = [[H,H],[H,-H]] is exactly the butterfly below, and H is
+// symmetric so the side it is applied from does not matter.
+static void ggml_escha_hadamard_128(float * v, int64_t n) {
+    const float scale = 1.0f/sqrtf(128.0f);
+
+    for (int64_t off = 0; off < n; off += 128) {
+        float * b = v + off;
+
+        for (int len = 1; len < 128; len <<= 1) {
+            for (int i = 0; i < 128; i += len << 1) {
+                for (int j = 0; j < len; j++) {
+                    const float a0 = b[i + j];
+                    const float a1 = b[i + j + len];
+
+                    b[i + j]       = a0 + a1;
+                    b[i + j + len] = a0 - a1;
+                }
+            }
+        }
+
+        for (int i = 0; i < 128; i++) {
+            b[i] *= scale;
+        }
+    }
+}
+
+// Escha codebook A, computed rather than looked up. Same QTIP-family trick as 3INST but
+// with its own multiplier and no addend, recovered from escham_reconstruct_kernel<1, K>.
+// The add is fp16 in the reference, so keep it there or the low bit drifts.
+static float ggml_escha_codebook(uint32_t idx) {
+    const uint32_t x = ((idx*0xcbac1fedu) & 0x8fff8fffu) ^ 0x3b603b60u;
+    ggml_fp16_t lo, hi;
+    memcpy(&lo, (const char *) &x,     sizeof(lo));
+    memcpy(&hi, (const char *) &x + 2, sizeof(hi));
+    const float v = GGML_CPU_FP16_TO_FP32(lo) + GGML_CPU_FP16_TO_FP32(hi);
+    return GGML_CPU_FP16_TO_FP32(GGML_CPU_FP32_TO_FP16(v));
+}
+
+// CUDA proved that the 16 dependency bits are cyclically consecutive in a stream of
+// 32-bit payload words.  Keep the original dep-table decoder below as the independent
+// scalar oracle in tests; this helper is the CPU production extractor.  Explicit
+// little-endian byte assembly avoids alignment, aliasing, and host-endian assumptions.
+uint16_t ggml_escha_decode_index_cyclic(const uint8_t * payload, int k, int r, int c) {
+    GGML_ASSERT(k == 2 || k == 3);
+    GGML_ASSERT(r >= 0 && r < 16);
+    GGML_ASSERT(c >= 0 && c < 16);
+
+    const int nw = 8*k;
+    const int nb = 32*nw;
+    const int pi = (r & 1) | (((r >> 3) & 1) << 1) | (((r >> 1) & 3) << 3);
+    int sp = ((32 - k) - k*(pi + 32*c + 4*(c >> 3))) % nb;
+    if (sp < 0) {
+        sp += nb;
+    }
+
+    const int g0 = sp >> 5;
+    const int w0 = g0 ? nw - g0 : 0;
+    const int w1 = w0 ? w0 - 1 : nw - 1;
+    const auto load_le32 = [](const uint8_t * p) {
+        return (uint32_t) p[0] | ((uint32_t) p[1] << 8) |
+               ((uint32_t) p[2] << 16) | ((uint32_t) p[3] << 24);
+    };
+    const uint32_t p0 = load_le32(payload + 4*w0);
+    const uint32_t p1 = load_le32(payload + 4*w1);
+
+    const unsigned sh = (unsigned) sp & 31u;
+    const uint32_t idx = sh == 0 ? p0 : (p0 >> sh) | (p1 << (32u - sh));
+    return (uint16_t) idx;
+}
+
+// Decode one 16x16 tile into row-major [r][c].  The dep table remains an input
+// for format compatibility and is deliberately unused by the production path; its
+// bit-by-bit interpretation remains the independent test oracle.
+static void ggml_escha_decode_tile(
+        const uint8_t * payload,
+        int k,
+        float * tile) {
+    for (int p = 0; p < 256; ++p) {
+        tile[p] = ggml_escha_codebook(ggml_escha_decode_index_cyclic(payload, k, p/16, p%16));
+    }
+}
+
+#if defined(GGML_ESCHA_CPU_PROFILE)
+// Profile-only state.  One slot is written by one worker, then read after the
+// operation's existing barrier; the normal Release build preprocesses this out.
+struct ggml_escha_cpu_profile {
+    uint64_t rotate_us = 0;
+    uint64_t decode_us = 0;
+    uint64_t mac_us = 0;
+    uint64_t barrier_us = 0;
+    uint64_t output_us = 0;
+    uint64_t tiles = 0;
+};
+static_assert(sizeof(ggml_escha_cpu_profile) == GGML_ESCHA_CPU_PROFILE_BYTES);
+#endif
+
+void ggml_compute_forward_escha_moe(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+    const ggml_tensor * code = dst->src[0];
+    const ggml_tensor * rin  = dst->src[1];
+    const ggml_tensor * rout = dst->src[2];
+    const ggml_tensor * lut  = dst->src[3];
+    const ggml_tensor * dep  = dst->src[4];
+    const ggml_tensor * x    = dst->src[5];
+    const ggml_tensor * ids  = dst->src[6];
+
+    const int64_t nct = code->ne[1];        // output tiles
+    const int64_t nit = code->ne[2];        // input tiles
+    const int64_t OC  = nct*16;
+    const int64_t IC  = nit*16;
+
+    const int64_t tile_stride   = code->ne[0];      // 16*K int16 per tile
+    const int64_t expert_stride = nit*nct*tile_stride;
+
+    const int16_t     * code_d = (const int16_t *)     code->data;
+    const ggml_fp16_t * rin_d  = (const ggml_fp16_t *) rin->data;
+    const ggml_fp16_t * rout_d = (const ggml_fp16_t *) rout->data;
+    GGML_UNUSED(dep);
+
+    // lut stays a src so old files still load and a future checkpoint on another escha
+    // codebook can be added without a format change. ggml_escha_codebook covers cbA.
+    GGML_UNUSED(lut);
+
+    const int64_t n_ids = ids->ne[0];
+    const int64_t nrows = n_ids*ids->ne[1];
+
+    // one row is one (token, slot) pair
+    const int64_t dr = (nrows + params->nth - 1)/params->nth;
+    const int64_t r0 = dr*params->ith;
+    const int64_t r1 = MIN(r0 + dr, nrows);
+
+    float * wdata = (float *) params->wdata + (IC + OC + 256)*params->ith;
+    float * u     = wdata;
+    float * acc   = u   + IC;
+    float * tile  = acc + OC;
+
+    for (int64_t ir = r0; ir < r1; ++ir) {
+        const int64_t it = ir / n_ids;
+        const int64_t is = ir % n_ids;
+
+        const int32_t e = *(const int32_t *)((const char *) ids->data + is*ids->nb[0] + it*ids->nb[1]);
+        GGML_ASSERT(e >= 0 && e < code->ne[3]);
+
+        const float * xr = (const float *)((const char *) x->data + (is % x->ne[1])*x->nb[1] + it*x->nb[2]);
+
+        const ggml_fp16_t * rin_e  = rin_d  + e*IC;
+        const ggml_fp16_t * rout_e = rout_d + e*OC;
+        const int16_t     * code_e = code_d + e*expert_stride;
+
+        for (int64_t i = 0; i < IC; ++i) {
+            u[i] = xr[i]*GGML_CPU_FP16_TO_FP32(rin_e[i]);
+        }
+        ggml_escha_hadamard_128(u, IC);
+
+        memset(acc, 0, OC*sizeof(float));
+
+        for (int64_t i = 0; i < nit; ++i) {
+            const float * ub = u + i*16;
+
+            for (int64_t j = 0; j < nct; ++j) {
+                ggml_escha_decode_tile((const uint8_t *)(code_e + (i*nct + j)*tile_stride), (int) tile_stride/16, tile);
+
+                float * ab = acc + j*16;
+                for (int r = 0; r < 16; ++r) {
+                    const float ur = ub[r];
+                    if (ur == 0.0f) {
+                        continue;
+                    }
+
+                    const float * tr = tile + r*16;
+                    for (int c = 0; c < 16; ++c) {
+                        ab[c] += ur*tr[c];
+                    }
+                }
+            }
+        }
+
+        ggml_escha_hadamard_128(acc, OC);
+
+        float * dr_ = (float *)((char *) dst->data + is*dst->nb[1] + it*dst->nb[2]);
+        for (int64_t c = 0; c < OC; ++c) {
+            dr_[c] = acc[c]*GGML_CPU_FP16_TO_FP32(rout_e[c]);
+        }
+    }
+}
+
+// ggml_compute_forward_escha_mul_mat
+//
+// dense sibling of the above: one weight matrix, no ids, so a row is just a token.
+
+void ggml_compute_forward_escha_mul_mat(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+    const ggml_tensor * code = dst->src[0];
+    const ggml_tensor * rin  = dst->src[1];
+    const ggml_tensor * rout = dst->src[2];
+    const ggml_tensor * lut  = dst->src[3];
+    const ggml_tensor * dep  = dst->src[4];
+    const ggml_tensor * x    = dst->src[5];
+
+    const int64_t nct = code->ne[1];        // output tiles
+    const int64_t nit = code->ne[2];        // input tiles
+    const int64_t OC  = nct*16;
+    const int64_t IC  = nit*16;
+
+    const int64_t tile_stride = code->ne[0];    // 16*K int16 per tile
+
+    const int16_t     * code_d = (const int16_t *)     code->data;
+    const ggml_fp16_t * rin_d  = (const ggml_fp16_t *) rin->data;
+    const ggml_fp16_t * rout_d = (const ggml_fp16_t *) rout->data;
+    GGML_UNUSED(dep);
+
+    // see ggml_compute_forward_escha_moe -- kept as a src for forward compatibility
+    GGML_UNUSED(lut);
+
+    const int64_t nrows = x->ne[1]*x->ne[2];
+
+    // With fewer rows than workers, row-only partitioning leaves most of the
+    // threadpool idle (in particular, decode has a single row). In that case
+    // keep each row's accumulation order unchanged, but split its output tiles
+    // across workers. The first worker's accumulator is shared; every worker
+    // retains private rotated-input and tile scratch from the existing plan.
+    if (nrows < params->nth) {
+        const int64_t thread_stride = IC + OC + 256 + GGML_ESCHA_CPU_PROFILE_BYTES/sizeof(float);
+        float * thread_wdata = (float *) params->wdata + thread_stride*params->ith;
+        float * u             = thread_wdata;
+        float * acc           = (float *) params->wdata + IC;
+        float * tile          = thread_wdata + IC + OC;
+
+        const int64_t dj = (nct + params->nth - 1)/params->nth;
+        const int64_t j0 = MIN(dj*params->ith,       nct);
+        const int64_t j1 = MIN(j0 + dj,              nct);
+
+        GGML_ASSERT(OC % 128 == 0);
+        const int64_t nblocks = OC/128;
+        const int64_t db = (nblocks + params->nth - 1)/params->nth;
+        const int64_t b0 = MIN(db*params->ith,       nblocks);
+        const int64_t b1 = MIN(b0 + db,              nblocks);
+
+#if defined(GGML_ESCHA_CPU_PROFILE)
+        GGML_ASSERT(params->nth <= GGML_MAX_N_THREADS);
+        auto * profile_ptr = ::new ((void *) (thread_wdata + IC + OC + 256)) ggml_escha_cpu_profile{};
+        ggml_escha_cpu_profile & profile = *profile_ptr;
+#endif
+
+        for (int64_t ir = 0; ir < nrows; ++ir) {
+            const int64_t i1 = ir % x->ne[1];
+            const int64_t i2 = ir / x->ne[1];
+
+            const float * xr = (const float *)((const char *) x->data + i1*x->nb[1] + i2*x->nb[2]);
+
+#if defined(GGML_ESCHA_CPU_PROFILE)
+            const int64_t rotate_start = ggml_time_us();
+#endif
+            for (int64_t i = 0; i < IC; ++i) {
+                u[i] = xr[i]*GGML_CPU_FP16_TO_FP32(rin_d[i]);
+            }
+            ggml_escha_hadamard_128(u, IC);
+#if defined(GGML_ESCHA_CPU_PROFILE)
+            profile.rotate_us += ggml_time_us() - rotate_start;
+#endif
+
+            memset(acc + j0*16, 0, (j1 - j0)*16*sizeof(float));
+
+            for (int64_t i = 0; i < nit; ++i) {
+                const float * ub = u + i*16;
+
+                for (int64_t j = j0; j < j1; ++j) {
+#if defined(GGML_ESCHA_CPU_PROFILE)
+                    const int64_t decode_start = ggml_time_us();
+                    ggml_escha_decode_tile((const uint8_t *)(code_d + (i*nct + j)*tile_stride), (int) tile_stride/16, tile);
+#if defined(GGML_ESCHA_CPU_PROFILE)
+                    profile.decode_us += ggml_time_us() - decode_start;
+                    const int64_t mac_start = ggml_time_us();
+#endif
+
+                    float * ab = acc + j*16;
+                    for (int r = 0; r < 16; ++r) {
+                        const float ur = ub[r];
+                        if (ur == 0.0f) {
+                            continue;
+                        }
+
+                        const float * tr = tile + r*16;
+                        for (int c = 0; c < 16; ++c) {
+                            ab[c] += ur*tr[c];
+                        }
+                    }
+#if defined(GGML_ESCHA_CPU_PROFILE)
+                    profile.mac_us += ggml_time_us() - mac_start;
+                    ++profile.tiles;
+#endif
+#else
+                    ggml_escha_decode_tile((const uint8_t *)(code_d + (i*nct + j)*tile_stride), (int) tile_stride/16, tile);
+
+                    float * ab = acc + j*16;
+                    for (int r = 0; r < 16; ++r) {
+                        const float ur = ub[r];
+                        if (ur == 0.0f) {
+                            continue;
+                        }
+
+                        const float * tr = tile + r*16;
+                        for (int c = 0; c < 16; ++c) {
+                            ab[c] += ur*tr[c];
+                        }
+                    }
+#endif
+                }
+            }
+
+#if defined(GGML_ESCHA_CPU_PROFILE)
+            const int64_t barrier_start = ggml_time_us();
+#endif
+            ggml_barrier(params->threadpool);
+#if defined(GGML_ESCHA_CPU_PROFILE)
+            profile.barrier_us += ggml_time_us() - barrier_start;
+            const int64_t output_start = ggml_time_us();
+#endif
+
+            float * dr_ = (float *)((char *) dst->data + i1*dst->nb[1] + i2*dst->nb[2]);
+            for (int64_t b = b0; b < b1; ++b) {
+                const int64_t c0 = b*128;
+                ggml_escha_hadamard_128(acc + c0, 128);
+
+                for (int64_t c = c0; c < c0 + 128; ++c) {
+                    dr_[c] = acc[c]*GGML_CPU_FP16_TO_FP32(rout_d[c]);
+                }
+            }
+#if defined(GGML_ESCHA_CPU_PROFILE)
+            profile.output_us += ggml_time_us() - output_start;
+            const int64_t reuse_barrier_start = ggml_time_us();
+#endif
+
+            // All readers/writers must finish before the shared accumulator is
+            // reused for the next prompt row.
+            ggml_barrier(params->threadpool);
+#if defined(GGML_ESCHA_CPU_PROFILE)
+            profile.barrier_us += ggml_time_us() - reuse_barrier_start;
+#endif
+        }
+
+#if defined(GGML_ESCHA_CPU_PROFILE)
+        if (IC >= 5120 && params->ith == 0) {
+            uint64_t rotate = 0, decode = 0, mac = 0, barrier = 0, output = 0, tiles = 0;
+            for (int ith = 0; ith < params->nth; ++ith) {
+                const float * profile_wdata = (const float *) params->wdata + thread_stride*ith + IC + OC + 256;
+                const ggml_escha_cpu_profile & p = *(const ggml_escha_cpu_profile *) profile_wdata;
+                rotate += p.rotate_us; decode += p.decode_us; mac += p.mac_us;
+                barrier += p.barrier_us; output += p.output_us; tiles += p.tiles;
+            }
+            fprintf(stderr,
+                    "ESCHA_CPU_PROFILE IC=%lld OC=%lld rows=%lld threads=%d tiles=%llu rotate_us=%llu decode_us=%llu mac_us=%llu barrier_us=%llu output_us=%llu\n",
+                    (long long) IC, (long long) OC, (long long) nrows, params->nth,
+                    (unsigned long long) tiles, (unsigned long long) rotate,
+                    (unsigned long long) decode, (unsigned long long) mac,
+                    (unsigned long long) barrier, (unsigned long long) output);
+        }
+#endif
+
+        return;
+    }
+
+    const int64_t dr = (nrows + params->nth - 1)/params->nth;
+    const int64_t r0 = dr*params->ith;
+    const int64_t r1 = MIN(r0 + dr, nrows);
+
+    float * wdata = (float *) params->wdata + (IC + OC + 256)*params->ith;
+    float * u     = wdata;
+    float * acc   = u   + IC;
+    float * tile  = acc + OC;
+
+    for (int64_t ir = r0; ir < r1; ++ir) {
+        const int64_t i1 = ir % x->ne[1];
+        const int64_t i2 = ir / x->ne[1];
+
+        const float * xr = (const float *)((const char *) x->data + i1*x->nb[1] + i2*x->nb[2]);
+
+        for (int64_t i = 0; i < IC; ++i) {
+            u[i] = xr[i]*GGML_CPU_FP16_TO_FP32(rin_d[i]);
+        }
+        ggml_escha_hadamard_128(u, IC);
+
+        memset(acc, 0, OC*sizeof(float));
+
+        for (int64_t i = 0; i < nit; ++i) {
+            const float * ub = u + i*16;
+
+            for (int64_t j = 0; j < nct; ++j) {
+                ggml_escha_decode_tile((const uint8_t *)(code_d + (i*nct + j)*tile_stride), (int) tile_stride/16, tile);
+
+                float * ab = acc + j*16;
+                for (int r = 0; r < 16; ++r) {
+                    const float ur = ub[r];
+                    if (ur == 0.0f) {
+                        continue;
+                    }
+
+                    const float * tr = tile + r*16;
+                    for (int c = 0; c < 16; ++c) {
+                        ab[c] += ur*tr[c];
+                    }
+                }
+            }
+        }
+
+        ggml_escha_hadamard_128(acc, OC);
+
+        float * dr_ = (float *)((char *) dst->data + i1*dst->nb[1] + i2*dst->nb[2]);
+        for (int64_t c = 0; c < OC; ++c) {
+            dr_[c] = acc[c]*GGML_CPU_FP16_TO_FP32(rout_d[c]);
+        }
+    }
+}
