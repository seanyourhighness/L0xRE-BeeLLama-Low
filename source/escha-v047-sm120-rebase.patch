+// ggml_compute_forward_lowgpu_get_rows
+//
+// LowGPU v1 3-bit vocab gather: decode the selected rows of the packed
+// embedding matrix directly into the F32 destination. Selected-row decode is
+// not full-model expansion (only the requested rows are touched).
+
+void ggml_compute_forward_lowgpu_get_rows(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+    const ggml_tensor * code  = dst->src[0];
+    const ggml_tensor * scale = dst->src[1];
+    const ggml_tensor * zp    = dst->src[2];
+    const ggml_tensor * ids   = dst->src[3];
+
+    const int64_t KB = code->ne[0];
+    const int64_t V  = code->ne[1];
+    const int64_t G  = scale->ne[0];
+    const int64_t n_embd = KB*8/3;
+    const int64_t n_ids  = ids->ne[0];
+
+    // Shape contract: 3 bytes per 8 codes, group size 128, one group per 128
+    // embedding dims. Reject malformed sidecars before touching data.
+    GGML_ASSERT(KB % 3 == 0);
+    GGML_ASSERT(n_embd % 128 == 0);
+    GGML_ASSERT(G == n_embd/128);
+
+    const uint8_t     * code_d  = (const uint8_t *)     code->data;
+    const ggml_fp16_t * scale_d = (const ggml_fp16_t *) scale->data;
+    const uint8_t     * zp_d    = (const uint8_t *)     zp->data;
+    const int32_t     * ids_d   = (const int32_t *)     ids->data;
+
+    const int64_t dr = (n_ids + params->nth - 1)/params->nth;
+    const int64_t i0 = dr*params->ith;
+    const int64_t i1 = MIN(i0 + dr, n_ids);
+
+    for (int64_t i = i0; i < i1; ++i) {
+        const int32_t r = ids_d[i];
+        if (r < 0 || r >= V) {
+            GGML_ABORT("lowgpu_get_rows: invalid token id %d (vocab size %lld)", r, (long long) V);
+        }
+        float *       dst_row  = (float *) ((char *) dst->data + i*dst->nb[1]);
+        const uint8_t * codes  = code_d  + (int64_t) r*KB;
+        const ggml_fp16_t * scales = scale_d + (int64_t) r*G;
+        const uint8_t * zps    = zp_d    + (int64_t) r*G;
+
+        for (int64_t t = 0; t < KB/3; ++t) {
+            const uint8_t b0 = codes[3*t + 0];
+            const uint8_t b1 = codes[3*t + 1];
+            const uint8_t b2 = codes[3*t + 2];
+
+            const uint8_t c[8] = {
+                (uint8_t) (b0 & 7),
+                (uint8_t) ((b0 >> 3) & 7),
+                (uint8_t) (((b0 >> 6) | (b1 << 2)) & 7),
+                (uint8_t) ((b1 >> 1) & 7),
+                (uint8_t) ((b1 >> 4) & 7),
+                (uint8_t) (((b1 >> 7) | (b2 << 1)) & 7),
+                (uint8_t) ((b2 >> 2) & 7),
+                (uint8_t) ((b2 >> 5) & 7),
+            };
+
+            const int64_t g = t*8/128; // 8 codes per triple, 128 per group
+            const float s = GGML_CPU_FP16_TO_FP32(scales[g]);
+            const float z = (float) zps[g];
+
+            for (int i = 0; i < 8; ++i) {
+                // Canonical LowGPU decode rounds the weight through F16
+                // (x_hat = (q - zp) * scale -> fp16), matching the CUDA kernel.
+                dst_row[8*t + i] = GGML_CPU_FP16_TO_FP32(GGML_CPU_FP32_TO_FP16(((float) c[i] - z) * s));
+            }
+        }
+    }
+}
