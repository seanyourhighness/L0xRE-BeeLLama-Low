+    GGML_ASSERT(dt->type == GGML_TYPE_F32 && a_log->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_nelements(dt) == tensor->src[4]->ne[1]);
+    GGML_ASSERT(ggml_are_same_shape(dt, a_log));
+    GGML_ASSERT(tensor->src[6] == NULL && tensor->src[7] == NULL);
+    tensor->src[6] = dt;
+    tensor->src[7] = a_log;
