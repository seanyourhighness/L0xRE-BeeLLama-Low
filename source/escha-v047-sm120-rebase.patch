+// Decode-only four-node epilogue:
+//   rms = RMS_NORM(x), weighted = rms * weight,
+//   activated = SiLU(gate), out = weighted * activated.
+//
+// The caller admits only contiguous F32 tensors with one row per block.  Keep
+// the reduction and arithmetic order aligned with rms_norm_f32 and
+// unary_gated_op_kernel so this remains a correctness-preserving launch
+// substitution rather than a new numerical path.
+template <int block_size>
+static __global__ void rms_norm_silu_mul_f32(
+        const float * __restrict__ x,
+        const float * __restrict__ weight,
+        const float * __restrict__ gate,
+        float       * __restrict__ dst,
+        const int ncols,
+        const float eps) {
+    const int row = blockIdx.x;
+    const int tid = threadIdx.x;
+
+    x    += (size_t) row*ncols;
+    gate += (size_t) row*ncols;
+    dst  += (size_t) row*ncols;
+
+    float tmp = 0.0f;
+    ggml_cuda_pdl_sync();
+    for (int col = tid; col < ncols; col += block_size) {
+        const float xi = x[col];
+        tmp += xi * xi;
+    }
+
+    extern __shared__ float s_sum[];
+    tmp = block_reduce<block_reduce_method::SUM, block_size>(tmp, s_sum);
+
+    const float scale = rsqrtf(tmp / ncols + eps);
+    ggml_cuda_pdl_sync();
+    for (int col = tid; col < ncols; col += block_size) {
+        const float weighted = scale * x[col] * weight[col];
+        const float g         = gate[col];
+        const float activated = g / (1.0f + expf(-g));
+        dst[col] = weighted * activated;
+    }
+}
+
+// Residual ADD followed by RMSNorm(x)*weight.  The residual result remains
+// live in the ADD destination while the normalized result is written to the
+// following MUL destination, matching the unfused graph's two outputs.
+template <int block_size>
+static __global__ void add_rms_norm_mul_f32(
+        const float * __restrict__ x0,
+        const float * __restrict__ x1,
+        const float * __restrict__ weight,
+        float       * __restrict__ residual,
+        float       * __restrict__ dst,
+        const int ncols,
+        const float eps) {
+    ggml_cuda_pdl_lc();
+    const int row = blockIdx.x;
+    const int tid = threadIdx.x;
+    x0       += (size_t) row*ncols;
+    x1       += (size_t) row*ncols;
+    residual += (size_t) row*ncols;
+    dst      += (size_t) row*ncols;
+
+    float tmp = 0.0f;
+    ggml_cuda_pdl_sync();
+    for (int col = tid; col < ncols; col += block_size) {
+        const float xi = x0[col] + x1[col];
+        residual[col] = xi;
+        tmp += xi*xi;
+    }
+    extern __shared__ float s_sum[];
+    tmp = block_reduce<block_reduce_method::SUM, block_size>(tmp, s_sum);
+    const float scale = rsqrtf(tmp/ncols + eps);
+    for (int col = tid; col < ncols; col += block_size) {
+        dst[col] = scale*residual[col]*weight[col];
+    }
+}
