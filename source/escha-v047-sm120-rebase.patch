+// the escha codec tables live on the model; every projection needs them
+static llm_escha_tables escha_tables_of(const llama_model & model) {
+    return { model.escha_lut, model.escha_dep_k2, model.escha_dep_k3 };
+}
+
+static bool escha_mvt_up_finalize_candidate_enabled() {
+    if (std::getenv("ESCHA_CANDIDATE") != nullptr) {
+        GGML_ABORT("escha MVT: un-attested ESCHA_CANDIDATE is unsupported");
+    }
+    const char * id    = std::getenv("ESCHA_CANDIDATE_ID");
+    const char * nonce = std::getenv("ESCHA_RUN_NONCE");
+    const char * spec  = std::getenv("ESCHA_SPEC_SHA256");
+    const char * path  = std::getenv("ESCHA_ATTESTATION_PATH");
+    const bool any_binding = (nonce != nullptr && *nonce != '\0') ||
+                             (spec != nullptr && *spec != '\0') ||
+                             (path != nullptr && *path != '\0');
+    if (id == nullptr || *id == '\0') {
+        if (any_binding) {
+            GGML_ABORT("escha MVT: candidate binding requires ID, nonce, spec SHA-256, and attestation path");
+        }
+        return false;
+    }
+    if (std::strcmp(id, "prefill_swiglu_up_finalize_mul_single_slice") != 0 ||
+        nonce == nullptr || *nonce == '\0' || spec == nullptr || *spec == '\0' ||
+        path == nullptr || *path == '\0') {
+        GGML_ABORT("escha MVT: invalid or incomplete candidate binding");
+    }
+    return true;
+}
