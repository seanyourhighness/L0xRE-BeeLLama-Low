+//
+// Arithmetic (SGLang reference, sglang_srt.../sglang_srt_layers_quantization_escha.py):
+//   fp16_weight[vocab, hidden] = fp16(int8_weight[vocab, hidden] * fp16_scale[vocab])
+// The GGML tensor is [n_embd, n_vocab] (hidden contiguous) which is byte-identical
+// to the torch [vocab, hidden] row-major layout, so no transpose is performed and
+// the scale indexes the vocab (outer) dimension ne[1].
+size_t llama_model_loader::fill_transformed(struct ggml_tensor * cur) const {
+    const char * name = ggml_get_name(cur);
+    const tensor_transform * tr = find_transform(name);
+    if (!tr) {
+        throw std::runtime_error(format("%s: no transform registered for '%s'", __func__, name));
+    }
+
+    const llama_tensor_weight * src_w   = get_weight(tr->src.c_str());
+    const llama_tensor_weight * scale_w = get_weight(tr->scale.c_str());
+    if (!src_w)   { throw std::runtime_error(format("%s: source weight '%s' not found", __func__, tr->src.c_str())); }
+    if (!scale_w) { throw std::runtime_error(format("%s: scale weight '%s' not found", __func__, tr->scale.c_str())); }
+
+    if (src_w->tensor->type   != GGML_TYPE_I8)  { throw std::runtime_error(format("%s: source '%s' is not I8", __func__, tr->src.c_str())); }
+    if (scale_w->tensor->type != GGML_TYPE_F16) { throw std::runtime_error(format("%s: scale '%s' is not F16", __func__, tr->scale.c_str())); }
