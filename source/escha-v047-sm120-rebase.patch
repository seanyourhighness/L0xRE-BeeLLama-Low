+// LowGPU v1 3-bit vocab LM head. In Round 1 this op executes ONLY on CUDA.
+// A full V x n_embd F16 expansion is forbidden by DoD C.3, so the CPU backend
+// fails closed. Backend placement (supports_op) is expected to reject this op
+// before dispatch; this is the defensive path if it is reached anyway.
+
+void ggml_compute_forward_lowgpu_mul_mat(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+    GGML_UNUSED(params);
+    GGML_UNUSED(dst);
+    GGML_ABORT("LowGPU v1 output head requires CUDA in Round 1; full F16 expansion is forbidden");
+}
