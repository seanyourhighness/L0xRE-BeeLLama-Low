#!/usr/bin/env bash
# L0xRE BeeLLama SM89 launcher (v0.4.7-sm89-r1)
set -euo pipefail
unset ESCHA_E3_HEAD_RT_BLOCK128 L0XRE_K3_VECTOR_CUBIN
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BRIDGE="$ROOT/bridge"
export LD_LIBRARY_PATH="$ROOT/bin:${LD_LIBRARY_PATH:-}"
export ESCHA_BRIDGE_ROOT="$BRIDGE"
export ESCHA_OFFICIAL_RAW_BRIDGE=1
export ESCHA_OFFICIAL_RAW_SWIGLU_FUSION=1
export ESCHA_OFFICIAL_RAW_DECODE_BRIDGE=1
export ESCHA_OFFICIAL_RAW_DECODE_F32_INPUT=1
export ESCHA_OFFICIAL_RAW_DECODE_SWIGLU_FUSION=1
export ESCHA_OFFICIAL_RAW_DECODE_K3_SPLIT_DIV2=0
export ESCHA_OFFICIAL_BRIDGE_ACCUMULATION=mixed
export ESCHA_OFFICIAL_CODE_GEMM_CUBIN="$BRIDGE/code-gemm-sm89.cubin"
export ESCHA_OFFICIAL_F32_DECODE_CUBIN="$BRIDGE/code-gemm-sm89.cubin"
export ESCHA_OFFICIAL_BRIDGE_LIBRARY="$BRIDGE/libescha_official_bridge_cuda_sm89.so"
export ESCHA_GDN_CHUNK_BRIDGE=1
export ESCHA_GDN_CHUNK_BRIDGE_LIBRARY="$BRIDGE/libescha_gdn_chunk_bridge_sm89_ported.so"
export ESCHA_GDN_CHUNK_CUBIN_ROOT="$BRIDGE/gdn-cubins-sm89-exact"
export ESCHA_E3_EMBED_GPU=1
export ESCHA_OFFICIAL_RAW_DECODE_DOWN_ADD_RMS_FUSION=1
export ESCHA_OFFICIAL_RAW_DECODE_K3_DOWN_SPLITS=12
export ESCHA_OFFICIAL_RAW_DECODE_QKV_Z_BETA_ALPHA_OVERLAP=1
export ESCHA_DIRECT_RECURRENT_STATE_R258=1
export ESCHA_DIRECT_RECURRENT_CONV_R260=1
export ESCHA_FUSE_GDN_DECODE_PREP_R262=1
export ESCHA_FUSE_GDN_NORM_GATE_R264=1
export ESCHA_W2_I8_HEAD=0
export ESCHA_E3_HEAD_MROW=8
export ESCHA_E3_HEAD_RT=2
export ESCHA_F16_SMALL_N_NATIVE=1
PROFILE="12gb"
HAVE_DRAFT=0
ARGS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --profile) [[ $# -ge 2 ]] || { echo "Missing profile value" >&2; exit 2; }; PROFILE="$2"; shift 2;;
    serve) shift;;
    -md|--draft-model|--spec-draft-model) HAVE_DRAFT=1; ARGS+=("$1"); shift;;
    *) ARGS+=("$1"); shift;;
  esac
done
case "$PROFILE" in 12gb|16gb|full32k) ;; *) echo "Unsupported SM89 profile: $PROFILE" >&2; exit 2 ;; esac
CTX=(); NMAX=3
case "$PROFILE" in
  12gb)    CTX=(-c 81920 -b 1024 -ub 64 -ctk kvarn3 -ctv kvarn2); NMAX=3;;
  16gb)    export GGML_KVARN_WINDOW_CHUNK=16384
           CTX=(-c 262144 -b 1024 -ub 512 -ctk kvarn3 -ctv kvarn3); NMAX=3;;
  full32k) CTX=(-c 32768 -b 2048 -ub 1024 -ctk kvarn3 -ctv kvarn2); NMAX=5;;
esac
SPEC=()
if [[ "$HAVE_DRAFT" == 1 ]]; then
  SPEC=(--spec-type draft-dflash --spec-draft-n-max "$NMAX" --spec-draft-ngl 99 \
        --spec-draft-type-k q4_0 --spec-draft-type-v q4_0)
fi
exec "$ROOT/bin/llama-server" -np 1 -t 8 -ngl 99 -fa on \
  --jinja --reasoning on --reasoning-effort low --reasoning-budget 8192 \
  --temp 0.7 --top-p 0.95 --top-k 20 --no-webui \
  "${CTX[@]}" "${SPEC[@]}" "${ARGS[@]}"
