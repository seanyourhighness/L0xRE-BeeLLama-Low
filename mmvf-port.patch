+// ESCHA MTP-0071 opt-in: allow the native F16 vector kernel to serve small multi-row batches
+// (ncols_dst = ne11) when the GEMM output width ("N", src0 rows) is tiny.
+//
+// On tensor-core NVIDIA GPUs ggml_cuda_should_use_mmvf() restricts the F16 vector kernel to a
+// single RHS column (ne11 == 1) because batched cuBLAS GEMM normally wins for anything wider.
+// For a very thin output with a small batch that GEMM degenerates into a launch/latency-bound
+// CUTLASS WMMA tile per projection, while mul_mat_vec_f<..., ncols_dst> already covers
+// ncols_dst = 1..MMVF_MAX_BATCH_SIZE and writes one dst column per thread. Unset = today's
+// behaviour; when set, only thin outputs are relaxed, so wide matmuls never leave cuBLAS.
+static bool escha_mmvf_small_n_multirow(const int64_t ne11, const int64_t nrows_out) {
+    static const char * const env = std::getenv("ESCHA_F16_SMALL_N_NATIVE");
+    if (env == nullptr || ne11 < 2 || ne11 > MMVF_MAX_BATCH_SIZE) {
+        return false;
+    }
+    return nrows_out <= 64;
+}
